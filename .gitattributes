# Set the default behavior for all files
* text=auto
# Declare files that will always have LF line endings on checkout
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.node binary
*.exe binary
*.dll binary
# Explicitly mark node modules as binary to avoid git issues
frontend/node_modules/**/*.node binary
backend/node_modules/**/*.node binary
node_modules/**/*.node binary
**/*.node filter=lfs diff=lfs merge=lfs -text
